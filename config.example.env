# Repository root. The scripts infer this automatically when stored in scripts/.
export CRC_BASE="/path/to/genome-first-crc-subtyping"

# Raw and reference inputs
export CRC_RAW_ROOT="/path/to/genomics_raw_vcf"
export CRC_VEP_DIR="${CRC_RAW_ROOT}/vep_output"
export CRC_CNV_DIR="${CRC_RAW_ROOT}/cnv"
export CRC_SV_DIR="${CRC_RAW_ROOT}/sv"
export CRC_REFERENCE_DIR="/path/to/reference"
export CRC_PANEL_FILE="${CRC_BASE}/colorectal_cancer_all_genes.txt"
export CRC_SUPP_TABLE="${CRC_BASE}/crc_heterogeneity_data/Supplementary_Table_01.xlsx"
export CRC_CLIN="${CRC_BASE}/clinical_data.tsv"

# Canonical subtype-label destination generated by script 05
export CRC_CLUSTER_FILE="${CRC_BASE}/module05_06_loocv_results/labels/NMF_k4_LOOCV.csv"

# Optional compute controls
export CRC_N_JOBS="8"
export CRC_M24_NBOOT="2000"
export CRC_M20_BOOTSTRAPS="2000"
export CRC_M22_BOOTSTRAPS="1000"
export CRC_M10_NCORES="4"
